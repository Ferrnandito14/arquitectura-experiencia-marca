{
  "env": {
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "extraKnownMarketplaces": {
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "hamzafer/claude-code-mods"
      }
    },
    "agent-router-tools": {
      "source": {
        "source": "github",
        "repo": "alexandernicholson/agent-router"
      }
    }
  },
  "enabledPlugins": {
    "context-bar@claude-code-mods": true,
    "usage-meter@claude-code-mods": true,
    "where-am-i@claude-code-mods": true,
    "blast-radius@claude-code-mods": true,
    "keepalive@agent-router-tools": true,
    "agent-radar@claude-code-mods": true,
    "mission-control@claude-code-mods": true,
    "replay-theater@claude-code-mods": true,
    "next-steps@claude-code-mods": true,
    "rulebook-guard@claude-code-mods": true,
    "cache-clock@claude-code-mods": true,
    "heatmap@claude-code-mods": true
