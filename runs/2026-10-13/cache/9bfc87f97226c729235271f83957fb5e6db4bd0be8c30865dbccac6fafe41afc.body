,\"unique\":\"The email has already been taken.\"},\"password\":{\"min\":\"The password must be at least 8 characters\",\"confirmed\":\"The password confirmation does not match.\",\"required\":\"The password field is required.\"},\"current_password\":{\"required\":\"The current password field is required.\",\"confirmed\":\"The current password confirmation does not match.\"},\"first_name\":{\"required\":\"The first name field is required.\",\"string\":\"The first name must be a string.\"}},\"required_with_all\":\"The {attribute} field is required when {values} are present.\",\"required_without_all\":\"The {attribute} field is required when none of {values} are present.\",\"same\":\"The {attribute} and {other} must match.\",\"size\":{\"numeric\":\"The {attribute} must be {size}.\",\"file\":\"The {attribute} must be {size} kilobytes.\",\"string\":\"The {attribute} must be {size} characters.\",\"array\":\"The {attribute} must contain {size} items.\"},\"required_with\":\"The {attribute} field is required when {values} is present.\",\"required_unless\":\"The {attribute} field is required unless {other} is in {values}.\",\"required_if\":\"The {attribute} field is required when {other} is {value}.\",\"required\":\"The {attribute} field is required.\",\"required_without\":\"The {attribute} field is required when {values} is not present.\",\"password\":\"The password is incorrect.\",\"regex\":\"The {attribute} format is invalid.\",\"string\":\"The {attribute} must be a string.\",\"timezone\":\"The {attribute} must be a valid zone.\",\"unique\":\"The {attribute} has already been taken.\",\"uploaded\":\"The {attribute} failed to upload.\",\"url\":\"The {attribute} format is invalid.\",\"uuid\":\"The {attribute} must be a valid UUID.\",\"present\":\"The {attribute} field must be present.\",\"starts_with\":\"The {attribute} must start with one of the following: {values}.\",\"alpha\":\"The {attribute} may only contain letters.\",\"gte\":{\"numeric\":\"The {attribute} must be greater than or equal {value}.\",\"string\":\"The {attribute} must be greater than or equal {value} characters.\",\"array\":\"The {attribute} must have {value} items or more.\",\"file\":\"The {attribute} must be greater than or equal {value} kilobytes.\"},\"gt\":{\"array\":\"The {attribute} must have more than {value} items.\",\"string\":\"The {attribute} must be greater than {value} characters.\",\"file\":\"The {attribute} must be greater than {value} kilobytes.\",\"numeric\":\"The {attribute} must be greater than {value}.\"},\"date_equals\":\"The {attribute} must be a date equal to {date}.\",\"date\":\"The {attribute} is not a valid date.\",\"filled\":\"The {attribute} field must have a value.\",\"file\":\"The {attribute} must be a file.\",\"distinct\":\"The {attribute} field has a duplicate value.\",\"dimensions\":\"The {attribute} has invalid image dimensions.\",\"digits_between\":\"The {attribute} must be between {min} and {max} digits.\",\"different\":\"The {attribute} and {other} must be different.\",\"alpha_dash\":\"The {attribute} may only contain letters, numbers, dashes and underscores.\",\"alpha_num\":\"The {attribute} may only contain letters and numbers.\",\"array\":\"The {attribute} must be an array.\",\"before\":\"The {attribute} must be a date before {date}.\",\"accepted\":\"The {attribute} must be accepted.\",\"active_url\":\"The {attribute} is not a valid URL.\",\"between\":{\"numeric\":\"The {attribute} must be between {min} and {max}.\",\"file\":\"The {attribute} must be between {min} and {max} kilobytes.\",\"string\":\"The {attribute} must be between {min} and {max} characters.\",\"array\":\"The {attribute} must have between {min} and {max} items.\"},\"boolean\":\"The {attribute} field must be true or false.\",\"confirmed\":\"The {attribute} confirmation does not match.\",\"max\":{\"file\":\"The {attribute} may not be greater than {max} kilobytes.\",\"string\":\"The {attribute} may not be greater than {max} characters.\",\"array\":\"The {attribute} may not have more than {max} items.\",\"numeric\":\"The {attribute} may not be greater than {max}.\"},\"mimes\":\"The {attribute} must be a file of type: {values}.\",\"mimetypes\":\"The {attribute} must be a file of type: {values}.\",\"min\":{\"numeric\":\"The {attribute} must be at least {min}.\",\"file\":\"The {attribute} must be at least {min} kilobytes.\",\"array\":\"The {attribute} must have at least {min} items.\",\"string\":\"The {attribute} must be at least {min} characters.\"},\"numeric\":\"The {attribute} must be a number.\",\"not_regex\":\"The {attribute} format is invalid.\",\"not_in\":\"The selected {attribute} is invalid.\",\"date_format\":\"The {attribute} does not match the format {format}.\",\"email\":\"The {attribute} must be a valid email address.\",\"ends_with\":\"The {attribute} must end with one of the following: {values}.\",\"lte\":{\"array\":\"The {attribute} must not have more than {value} items.\",\"string\":\"The {attribute} must be less than or equal {value} characters.\",\"file\":\"The {attribute} must be less than or equal {value} kilobytes.\",\"numeric\":\"The {attribute} must be less than or equal {value}.\"},\"exists\":\"The selected {attribute} is invalid.\",\"json\":\"The {attribute} must be a valid JSON string.\",\"ipv6\":\"The {attribute} must be a valid IPv6 address.\",\"lt\":{\"numeric\":\"The {attribute} must be less than {value}.\",\"file\":\"The {attribute} must be less than {value} kilobytes.\",\"string\":\"The {attribute} must be less than {value} characters.\",\"array\":\"The {attribute} must have less than {value} items.\"},\"ipv4\":\"The {attribute} must be a valid IPv4 address.\",\"ip\":\"The {attribute} must be a valid IP address.\",\"integer\":\"The {attribute} must be an integer.\",\"in_array\":\"The {attribute} field does not exist in {other}.\",\"in\":\"The selected {attribute} is invalid.\",\"image\":\"The {attribute} must be an image.\",\"after\":\"The {attribute} must be a date after {date}.\",\"after_or_equal\":\"The {attribute} must be a date after or equal to {date}.\",\"before_or_equal\":\"The {attribute} must be a date before or equal to {date}.\",\"digits\":\"The {attribute} must be {digits} digits.\"},\"passwords\":{\"test\":\"the new translation\",\"reset\":\"Your password has been reset!\",\"sent\":\"We have emailed your password reset link!\",\"throttled\":\"Please wait before retrying.\",\"token\":\"This password reset token is invalid.\",\"user\":\"We can't find a user with that email address.\"},\"email\":{\"Bankroll Activated\":\"Bankroll Activated\",\"confirm_text\":\"Please click the button below to verify your email address.\",\"Reset Password\":\"Reset Password\",\"Verify Email Address\":\"Verify Email Address\",\"renewal_failed\":{\"p_1\":\"We failed to process your Premium subscription renewal, please make sure your payment details are updated - \u003ca href=\\\"{billing_url}\\\"\u003ebilling details here\u003c/a\u003e - so you don’t lose access to the exclusive Premium features:\"},\"Thank you for Renewing your Premium\":\"Thank you for Renewing your Premium\",\"renewal_success\":{\"p_1\":\"Your Premium subscription has been renewed for another month! We hope you enjoy the experience. Thank you for supporting \u003ca href=\\\"{apwin_url}\\\"\u003eAPWin\u003c/a\u003e, your contribution is a big deal to us! Make sure to access exclusive features such as:\"},\"failed_renew_subject\":\"ACTION REQUIRED: Your APWin Premium Subscription Cannot Be Processed\",\"cancelation\":{\"q_2\":\"What was the main reason for your premium subscription cancelation?\",\"q_1\":\"Is there anything else you would have liked to see on our platform?\",\"p_2\":\"The good news is that you can still access all the free stats on \u003ca href=\\\"{apwin_url}\\\"\u003eAPWin\u003c/a\u003e. We pride ourselves in delivering the best stats and predictions, I would like to ask you two questions:\",\"p_1\":\"Sad to see you go!\"},\"Your Premium Has Been Canceled\":\"Your Premium Has Been Canceled\",\"paid\":{\"p_2\":\"Your subscription will automatically be charged every thirty days at {price}/month until canceled, and you can cancel and manage \u003ca href=\\\"{billing_url}\\\"\u003ebilling details here\u003c/a\u003e.\",\"p_1\":\"Welcome to \u003ca href=\\\"{apwin_url}\\\"\u003eAPWin\u003c/a\u003e! Thank you for subscribing to the \u003cb\u003ePremium\u003c/b\u003e membership. You can now access exclusive features such as:\"},\"Your Premium is Now Active\":\"Your Premium is Now Active\",\"Welcome to APWin\":\"Welcome to APWin\",\"trial\":{\"p_1\":\"Welcome to \u003ca href=\\\"{apwin_url}\\\"\u003eAPWin\u003c/a\u003e! Thank you for subscribing to the \u003cb\u003ePremium\u003c/b\u003e trial. You can now access exclusive features such as:\",\"p_2\":\"Your subscription will automatically change to a paid subscription within seven days at {price}/month until canceled, and you can cancel and manage \u003ca href=\\\"{billing_url}\\\"\u003ebilling details here\u003c/a\u003e.\"},\"Founder\":\"Founder\",\"general_terms\":\"By keeping your subscription or an active account at APWin, you agree with the \u003ca href=\\\"{terms_url}\\\"\u003eTerms and Conditions\u003c/a\u003e, \u003ca href=\\\"{cookies_url}\\\"\u003eCookies Policy\u003c/a\u003e, and \u003ca href=\\\"{privacy_url}\\\"\u003ePrivacy Policy\u003c/a\u003e. You can also reach out to our support team by \u003ca href=\\\"{contact_url}\\\"\u003econtacting us\u003c/a\u003e.\",\"Your Premium is Renewing Soon\":\"Your Premium is Renewing Soon\",\"reminder\":{\"p_1\":\"I hope you are doing well and enjoying \u003ca href=\\\"{apwin_url}\\\"\u003eAPWin\u003c/a\u003e! This is just a friendly reminder that your subscription will renew automatically in seven days at {price}/month. Make sure your payment details are correct so you can keep access to the exclusive features:\"},\"Your 7-day Trial is Now Active\":\"Your 7-day Trial is Now Active\",\"bankroll_3\":\"Profile \u003e Bankroll Management\",\"bankroll_1\":\"Your request to have the Bankroll Management on your account was approved.\",\"bankroll_6\":\"Martim from APWin\",\"bankroll_4\":\"You will have to continue being premium to have access to the Dashboard\",\"bankroll_2\":\"You can access the Dashboard by clicking \u003ca href=\\\"{url}\\\"\u003ethis link\u003c/a\u003e, or by following the steps:\",\"bankroll_5\":\"Thank you, and best of luck,\",\"Email Confirmation\":\"Email Confirmation\",\"from APWin\":\"from APWin\",\"Thank you\":\"Thank you\",\"to confirm your account\":\"to confirm your account.\",\"password_reset\":{\"line_5\":\"Keep your password secure and never share it with anyone.\",\"line_7\":\"APWin Team.\",\"line_6\":\"Thanks\",\"line_4\":\"Click Here\",\"line_3\":\"To reset your password, please follow the link below:\",\"line_1\":\"Hello\",\"line_2\":\"We’ve sent you this email because you requested to reset your password on APWin.\"},\"Click here\":\"Click here\",\"Hello\":\"Hello\",\"Thank you for your sign up with APWin\":\"Thank you for your sign up with APWin.\"},\"match_predictions\":{\"team_trends\":{\"under_15_ht_goals\":\"{team} has had Under 1.5 HT Goals in its last {number} matches\",\"over_15_ht_goals\":\"{team} has had Over 1.5 HT Goals in its last {number} matches\",\"win\":\"{team} has won its last {number} matches\",\"matches_concending_goals\":\"{team} has conceded at least a goal in its last {number} matches\",\"over_25_goals\":\"{team} has had Over 2.5 Goals in its last {number} matches\",\"over_95_corners\":\"{team} has had Over 9.5 Corners in its last {number} matches\",\"under_95_corners\":\"{team} has had Under 9.5 Corners in its last {number} matches\",\"ht_under_15_goals\":\"{team} has had Under 1.5 HT Goals in its last {number} matches\",\"ht_over_15_goals\":\"{team} has had Over 1.5 HT Goals in its last {number} matches\",\"wins\":\"{team} has won its last {number} matches\",\"under_25_goals\":\"{team} has had Under 2.5 Goals in its last {number} matches\",\"over_35_goals\":\"{team} has had Over 3.5 Goals in its last {number} matches\",\"no_losses\":\"{team} hasn’t lost in its last {number} matches\",\"no_wins\":\"{team} hasn’t won in its last {number} matches\",\"losses\":\"{team} has lost its last {number} matches\",\"draws\":\"{team} has drawn its last {number} matches\"},\"h2h_trends\":{\"under_15_ht_goals\":\"The past {number} matches between {team_a} and {team_b} have ended with under 1.5 HT goals\",\"over_15_ht_goals\":\"Over 1.5 HT Goals - The past {number} matches between {team_a} and {team_b} have ended with over 1.5 HT goals\",\"win\":\"{team_a} has won the last {number} matches against {team_b}\",\"under_95_corners\":\"The past {number} matches between {team_a} and {team_b} have ended with under 9.5 Corners\",\"losses\":\"{team_a} has lost its last {number} matches against {team_b}\",\"under_25_goals\":\"The past {number} matches between {team_a} and {team_b} have ended with under 2.5 goals\",\"ht_under_15_goals\":\"The past {number} matches between {team_a} and {team_b} have ended with under 1.5 HT goals\",\"ht_over_15_goals\":\"Over 1.5 HT Goals - The past {number} matches between {team_a} and {team_b} have ended with over 1.5 HT goals\",\"no_wins\":\"{team_a} hasn’t won any of the past {number} matches against {team_b}\",\"no_losses\":\"{team_a} hasn’t lost any of its past {number} matches against {team_b}\",\"over_25_goals\":\"The past {number} matches between {team_a} and {team_b} have ended with over 2.5 goals\",\"over_35_goals\":\"The past {number} matches between {team_a} and {team_b} have ended with over 3.5 goals\",\"matches_concending_goals\":\"{team_a} has conceded at least a goal in its last {number} matches against {team_b}\",\"draws\":\"The last {number} matches between {team_a} and {team_b} have ended in a draw\",\"wins\":\"{team_a} has won the last {number} matches against {team_b}\",\"over_95_corners\":\"The past {number} matches between {team_a} and {team_b} have ended with over 9.5 Corners\"},\"bonus_text\":\"Bet {base} and win {winning}\",\"statistic\":{\"corners\":\"{team_a} and {team_b} average {number} match corners per match\",\"cards\":\"{team_a} and {team_b} average {number} yellow cards per match\",\"over_25\":\"{number} of the matches involving {team_a} and {team_b} have finished with Over 2.5 Goals\",\"btts\":\"{team_a} and {team_b} have BTTS in {number} of their matches\",\"goal_average\":\"{team_a} and {team_b} average {number} goals scored per match\"}},\"terms_conditions\":{\"lists\":{\"title_10\":\"Of the odds of partner websites and their licenses\",\"description_10\":\"\\n        \u003cp\u003eAPWin is not responsible for:\u003c/p\u003e\\n            \u003cp\u003ea) the truth and up to date information of the odds shown by partner websites.\u003c/p\u003e\\n            \u003cp\u003eb) promoting a specific website where the user may not be able to access it due to its country’s regulation.\u003c/p\u003e\\n        \",\"description_7\":\"\\n        \u003cp\u003eThe user can cancel the contracting of the services (directly on the Hotmart website) at the moment he/she deems convenient.\u003c/p\u003e\\n        \u003cp\u003eFurthermore, the user can also cancel the services within 7 (seven) days, free of charge, after contracting, directly on the platform of Hotmart, APWin's payment partner.\u003c/p\u003e\\n        \u003cp\u003eThe service may be canceled by:\u003c/p\u003e\\n        \u003cp\u003ea) part of the user: under these conditions, the services will only cease when the current cycle at the time of cancellation is completed, in accordance with the user's interest (As per point 7.1).\u003c/p\u003e\\n        \u003cp\u003eb) violation of the Terms of Use: the services will be terminated immediately.\u003c/p\u003e\\n        \",\"title_7\":\"Cancellation\",\"title_1\":\"The Goal\",\"description_6\":\"$16\",\"description_5\":\"\\n        \u003cp\u003eThe platform may provide the user with a specific set of features and tools to optimize the use of services and products.\u003c/p\u003e\\n        \u003cp\u003eOn the platform, the services or products offered are described and presented with the highest degree of accuracy, containing information on their characteristics, qualities, quantities, composition, price, warranty, expiration dates and origin, among other data, as well as on the risks that present to the health and safety of the user.\u003c/p\u003e\\n        \u003cp\u003eBefore finalizing the purchase of a particular product or service, the user must be informed about its specifications and its destination.\u003c/p\u003e\\n        \u003cp\u003eEvery user can enjoy APWin's services for 7 days free after entering their payment details on APWin's partner payment website (Hotmart). After 7 days, the service will automatically activate and you will be billed. Service renewal is automatic after 30 days of use.\u003c/p\u003e\\n        \",\"title_3\":\"User Access\",\"title_6\":\"Pricing\",\"title_5\":\"Products or Services\",\"description_4\":\"$17\",\"title_4\":\"Registration\",\"description_3\":\"\u003cp\u003eAll technical solutions available to the person responsible for the platform will be used to allow access to the service 24 (twenty-four) hours a day, 7 (seven) days a week.\u003c/p\u003e \u003cp\u003eHowever, browsing on the platform or on any of its pages may be interrupted, limited or suspended for updates, modifications or any action necessary for its proper functioning.\u003c/p\u003e\",\"description_2\":\"\u003cp\u003eThis Term establishes obligations contracted of free and spontaneous will, for an indefinite period, between the platform and individuals or legal entities, users of the website OR application.\u003c/p\u003e \u003cp\u003eBy using the platform, the user fully accepts these rules and undertakes to comply with them, at the risk of applying the applicable penalties.\u003c/p\u003e \u003cp\u003eAcceptance of this instrument is essential for accessing and using any services provided by the company. If you do not agree with the provisions of this instrument, the user must not use them.\u003c/p\u003e\",\"description_11\":\"$18\",\"title_12\":\"Sanctions\",\"description_12\":\"\\n        \u003cp\u003eWithout prejudice to other applicable legal measures, APWin may, at any time, warn, suspend or cancel the user's account:\u003c/p\u003e\\n        \u003cp\u003ea) that violates any provision of this Term.\u003c/p\u003e\\n        \u003cp\u003eb) who fails to comply with their user duties.\u003c/p\u003e\\n        \u003cp\u003ec) that has any fraudulent, fraudulent or offending behavior to third parties.\u003c/p\u003e\\n        \",\"description_13\":\"\u003cp\u003eFailure to comply with the obligations set forth in this Terms of Use or applicable legislation may, without prior notice, lead to immediate unilateral termination by APWin and the blocking of all services provided to the user.\u003c/p\u003e\",\"title_14\":\"Changes\",\"description_14\":\"\\n        \u003cp\u003eThe items described in this instrument may be changed, unilaterally and at any time, by APWin, to adapt or modify the services, as well as to meet new legal requirements. The changes will be published OR via the website or by email and the user may choose to accept the new content or to cancel the use of the services, if he is a subscriber to any service.\u003c/p\u003e\\n        \u003cp\u003eThe services offered may, at any time and unilaterally, and without any prior notice, be discontinued, altered in their characteristics, as well as restricted for use or access.\u003c/p\u003e\\n        \",\"title_15\":\"Privacy Policy\",\"description_9\":\"$19\",\"title_2\":\"Acceptance\",\"description_1\":\"\u003cp\u003eThe platform aims to license the use of its software, website, applications and other intellectual property assets, providing tools to assist and streamline the daily lives of its users.\u003cp\u003e \u003cp\u003eThe platform is characterized by providing the following service: \u003cstrong\u003eAPWin Premium Subscription.\u003c/strong\u003e\u003c/p\u003e\",\"description_15\":\"\\n        \u003cp\u003eIn addition to this Term, the user must consent to the provisions contained in the respective Privacy Policy to be presented to all interested parties within the platform interface.\u003c/p\u003e\\n        \u003cp\u003e\u003cstrong\u003eAny disputes must be filed in the court in which the company's headquarters are located.\u003c/strong\u003e\u003c/p\u003e\\n        \",\"title_11\":\"Copyright\",\"title_13\":\"Termination\",\"title_9\":\"Responsibilities\",\"description_8\":\"\u003cp\u003eIn case of any doubts, suggestions or problems with the use of the platform, the user can contact support through the email on the contact page of the APWin website.\u003c/p\u003e\",\"title_8\":\"Support\"},\"sublist\":{\"parent_7\":{\"0\":{\"description_7\":{\"1\":\"\\n                \u003cp\u003eIf the user wishes to cancel the service, he must access his account at Hotmart (with the same credentials that give him access to APWin, or with the access data to Hotmart, if he has them).\u003c/p\u003e\\n                \u003cp\u003eAfter logging into their Hotmart account, the user must access APWin - Premium, click on the “Configure Payment” option, and then on “Cancel Subscription”.\u003c/p\u003e\\n                \u003cp\u003eOnce cancellation is made, the account will be inactive at the end of the billing period. That is, if the subscription was contracted on the 10th, and the cancellation is made on the 15th, the account will be inactive only on the 10th of the following month, the end of the billing period.\u003c/p\u003e\"},\"title_7\":{\"1\":\"Cancellation by the user\"}},\"1\":{\"title_7\":{\"2\":\"Data deletion\"},\"description_7\":{\"2\":\"\\n                \u003cp\u003eIf the user would like to have its data deleted from APWin, they should send an email to martim@apwin.com, in the following format:\u003c/p\u003e\\n                \u003cp\u003e- Subject: Data deletion - #username.\u003c/p\u003e\\n                \u003cp\u003e- Email body: Request to formally delete my data.\u003c/p\u003e\\n                \u003cp\u003eAs soon as the email is received, the user data will be deleted.\u003c/p\u003e\\n                \"}},\"description_7\":\"\\n            \u003cp\u003eIf the user wishes to cancel the service, he must access his account at Hotmart (with the same credentials that give him access to APWin, or with the access data to Hotmart, if he has them).\u003c/p\u003e\\n            \u003cp\u003eAfter logging into their Hotmart account, the user must access APWin - Premium, click on the “Configure Payment” option, and then on “Cancel Subscription”.\u003c/p\u003e\\n            \u003cp\u003eOnce cancellation is made, the account will be inactive at the end of the billing period. That is, if the subscription was contracted on the 10th, and the cancellation is made on the 15th, the account will be inactive only on the 10th of the following month, the end of the billing period.\u003c/p\u003e\\n            \",\"title_7\":\"Cancellation by the user\"}},\"main_title\":\"General Terms and Conditions of Use of APWin Premium Subscription\",\"main_description\":\"APWin's services are provided by the legal entity OR individual with the following Corporate Name/name: APWin Pte. Ltd, with trade name APWin, with taxpayer number 202229098C, owner of intellectual property on software, website, applications, content and others assets related to the APWin.com platform.\"},\"pagination\":{\"previous\":\"Previous\",\"next\":\"Next\"},\"pricing\":{\"per month\":\"/month\",\"Premium Content\":\"Premium Content\",\"Fair Odds\":\"Fair Odds\",\"Academy\":\"Academy\",\"Pricing\":\"Pricing\",\"Ready to Join APWin Community?\":\"Ready to Join APWin Community?\",\"get_access_to_exclusive\":\"Get access to exclusive football data and improve your results\",\"Premium\":\"Premium\",\"Premium 7-days FREE\":\"Premium 7-days FREE\",\"Manage Billing\":\"Manage Billing\",\"for_individuals_getting_started\":\"For individuals getting started with football statistics\",\"Free\":\"Free\",\"Basic Statistics\":\"Basic Statistics\",\"League Statistics\":\"League Statistics\",\"Team \u0026 Player Statistics\":\"Team \u0026 Player Statistics\",\"Current Subscription\":\"Current Subscription\",\"havent_found_contact_us\":\"Haven't found what you are looking for? \u003ca href='{url}' target='_blank'\u003eContact us\u003c/a\u003e\",\"Frequent Asked Questions\":\"Frequent Asked Questions\",\"our_payments\":\"Our payments are securely managed by Hotmart, we don't save your data\",\"Secure Payment\":\"Secure Payment\",\"no_contract\":\"No contracts, you can request to cancel any time free of charge\",\"Cancel Anytime\":\"Cancel Anytime\",\"Accepted Payment Methods\":\"Accepted Payment Methods\",\"Try 7 Days FREE\":\"Try 7 Days FREE\",\"best_for_individuals\":\"Best for individuals who want to perform better when betting.\",\"Join For Free\":\"Join For Free\",\"Bankroll Management\":\"Bankroll Management\",\"Team Form\":\"Team Form\",\"faq\":{\"title_2\":\"How much does Premium cost?\",\"description_5\":\"No. All of the payments are connected to Hotmart, which means that we have no control over Trial periods, subscriptions, or cancellations. As such, everyone that wishes to use our platform can do it under the same conditions, which is 7 days Free Trial and {price} after that.\",\"description_2\":\"Premium costs {price} per month, or the equivalent in your currency if you are outside of the Euro Zone. We made a price low enough to be accessible to our subscribers, but just high enough that allows us to continue to provide our platform, and software to you.\",\"title_7\":\"Which currencies are supported?\",\"description_1\":\"With Premium, you will get some of the features that are exclusive to our subscribers, extra content, and others. Some of the features include A Bankroll Management Tool, The Team Form, More Detailed Stats, Premium Content, and some of the other features that are being implemented and will be implemented in the future.\",\"title_5\":\"Can I extend the Trial?\",\"description_6\":\"Your subscription will be automatically renewed 30 days after subscribing Premium, and after that, once per month, on the same day. So for example, if you subscribe for the Trial on the 1st of the month, you will become Premium after the 8th of the month, and your subscription will be renewed automatically on the 8th of the next month.\",\"title_6\":\"How can I renew my subscription?\",\"description_3\":\"Yes. You can have 7 days for Free of Premium, and if you are not happy with the features, you can always cancel your subscription anytime you want.\",\"description_7\":\"Hotmart, our partner that manages the payments, supports more than 50 of the world’s most widely used currencies. If, however, your currency is not supported by Hotmart, you can use Euro as the default payment currency. \",\"description_4\":\"You can pay in the Premium Tab. All our payments are managed by our partner, Hotmart, so if you want to cancel your subscription, for whatever reason, you should also cancel it with Hotmart. We do not manage any payments.\",\"title_3\":\"Can I try for Free?\",\"title_8\":\"What payment methods are available?\",\"title_1\":\"What do I get with Premium?\",\"description_8\":\"As of now, only cards are accepted, VISA and Mastercard. Só you can make the payment with any card you prefer.\",\"title_4\":\"Where do I pay?\"}},\"auth\":{\"not_receive_confirmation_email\":\"If you didn't receive the email\",\"forgot_password\":{\"token_invalid\":\"Your reset URL has expired. Please request a new link by filling the form below.\",\"success\":\"We have e-mailed your password reset link!\"},\"facebook_failed\":\"Please set your email first on your facebook account.\",\"register\":{\"success\":\"Please check your email to confirm your account. If you don’t see it, check your spam folder. If you still haven’t received the email, try sending it again.\"},\"email_not_verified\":\"Please verify your email first.\",\"verified_success\":\"Verification successful. You can now log in!\",\"throttle\":\"Too many login attempts. Please try again in seconds.\",\"twitter_failed\":\"Your X account must have an email address linked to it.\",\"failed\":\"These credentials do not match our records.\"},\"bankroll\":{\"section_5\":{\"title\":\"What will you gain from it?\",\"list_check\":{\"title_3\":\"Better Focus\",\"description_6\":\"You can access the dashboard in any device, anywhere in the world with an internet access.\",\"description_1\":\"You will be able to know what you are good, and not so good at, with full transparency. Using that for your bets means that you will have a much better performance.\",\"title_6\":\"Easy Access\",\"description_7\":\"The dashboard will be like seeing for the 1st time. And with that, you will have a better performance than that new tactic or strategy.\",\"title_2\":\"Full Transparency\",\"description_2\":\"No more guessing. Your bets are recorded, and your performance is updated based on your bets. You will be able to pinpoint your performance with full transparency.\",\"title_4\":\"Better Decisions\",\"description_4\":\"When you focus on what matters, you also make more informed decisions. And better decisions = more profit.\",\"title_7\":\"Better Performance\",\"title_1\":\"Better Performance, Better Results\",\"description_3\":\"As soon as you learn where you're good and where you can improve, you will be able to focus on your strong points and make better decisions.\"}},\"section_4\":{\"title\":\"Improve Your Performance, or Get your Money Back\",\"description\":\"We are so sure that you will be able to see for the 1st time, that we guarantee you that your performance will improve. And if it doesn't you'll get your money back.\"},\"meta\":{\"description\":\"Our bankroll management lets you keep track of all your bets in one single place, ensuring a more effective way to profit.\",\"title\":\"Effective Sports Betting Bankroll Management\"},\"section_2\":{\"description\":\"We usually only want to know new tactics and tips, but as long as we bet completely blind, we are putting is in a position to loose.\",\"title\":\"The #1 Thing That Will Improve Your Performance the Most\"},\"section_3\":{\"description\":\"You will be able to see your performance per country, per competition, bet type, among others. 100% dynamically, for 10x better performance.\",\"title\":\"Get 10x More Granular Data\"},\"section_1\":{\"title_3\":\"Improve your Decisions \u0026 Performance\",\"description_4\":\"As long as you have internet access, you will be able to access it anywhere in the world.\",\"description_1\":\"You will be able to see your performance in detail, for the 1st time.\",\"description_2\":\"You will be able to see extremely granular data, and make 10x better decisions with that data.\",\"description_3\":\"If you know which day of the week, or which country brings you the least amount of profits, that is the kind of decision that will bring you great results.\",\"title_1\":\"See For The 1st Time\",\"title_2\":\"Get Unlimited Details\",\"title_4\":\"Access it Anytime, Anywhere\"},\"top_hero\":{\"description\":\"APWin's Bankroll Management allows you to, finally, be able to understand your performance in detail, and make better decisions than ever before.\",\"title\":\"Not Knowing Your Performance in Details is Like Betting With Blindfolds\"},\"bottom_hero\":{\"title\":\"SEE your performance. Improve and profit with our Bankroll Management\",\"description\":\"Be able to finally know your performance in detail, make infinitely better decisions, and improve your performance.\"}},\"title\":{\"page\":{\"teams\":\"Football Teams Statistics for All Countries\",\"trends\":\"Trends for Football Betting Predictions\",\"player\":\"Statistics Details for {player_name}\",\"leagues\":\"Worldwide Football Leagues and Competitions\"}},\"privacy\":{\"The continuous use of our website\":\"The continuous use of our website will be considered as you accepting our practices around privacy and personal information. If you have any doubt of how we deal with your data and personal information, get in touch with us.\",\"The website you were in before accessing apwin\":{\"com\":\"The website you were in before accessing apwin.com\"},\"The internet browser\":\"The internet browser you use and the operational system you are using\",\"The name of your domain\":\"The name of your domain (this can be your internet provider, or your place of work), and your IP (from where you are accessing  our website)\",\"How many, and which pages you visit\":\"How many, and which pages you visit during a session on our website, and for how long you were there\",\"Date and time you accessed our website\":\"Date and time you accessed our website\",\"Other collected information\":\"Other collected information during your visit to our website\",\"The information includes the following\":\"The information includes the following:\",\"The information doesn’t identify you personally\":\"The information doesn’t identify you personally. They only tell us how many people access our website and thet device they use. With that information, we can improve our website for all our users, including you.\",\"Everytime you navigate in\":\"Everytime you navigate in \u003ca href=\\\"https://www.apwin.com\\\"\u003ewww.apwin.com\u003c/a\u003e, read pages or download content, our system will automatically save certain information about your visit from your computer or device you use to access our website.\",\"If you have allowed us to use your personal data\":\"If you have allowed us to use your personal data for the purposes mentioned above, we reserve ourselves the right to transfer that information to any company or organization to whom we give the responsibility of sending emails or other communication pieces on our behalf. If that happens, we guarantee that any 3rd party that has access to your data is obeying the current Data Protection laws.\",\"Your privacy is important for us\":\"Your privacy is important for us. As such, it’s a part of ApWin’s policy to respect your privacy related to any information that we may save on our website, and other websites we have and operate.\",\"Send periodic emails with promotions\":\"Send periodic emails with promotions and products that we believe are of your interest\",\"Send you relevant information\":\"Send you relevant information on your products and services\",\"Help provide you a better experience\":\"Help provide you a better experience\",\"We use that data to\":\"We use that data to:\",\"This data can include information\":\"This data can include information such as your name, email, address, country and preferred language.\",\"We collect your data in a formulary\":\"We collect your data in a formulary.\",\"Which personal information is collected\":\"Which personal information is collected?\",\"You can refuse the sharing\":\"You can refuse the sharing of informations knowing that we may not be able to provide you some of the requested services.\",\"Our website may have links\":\"Our website may have links to outside websites that are not operated by us. You should be aware that we do not have control over content and practices of these websites and we cannot accept responsibility for their privacy policies.\",\"We do not share identification\":\"We do not share identification information personally or publicly with 3rd parties, except when requested by law.\",\"We only keep the collected\":\"We only keep the collected information for the time needed to provide you the service proposed. When we store data, we protect it within what is commonly accepted so that we avoid losses and theft, as well as access, sharing, copy or unauthorized use.\",\"We only ask for information\":\"We only ask for information when we really need it to provide you a service. We do it with fair and legal means, with your knowledge and consent. We also inform you why we are doing it, and how your data will be used.\",\"privacy_policy\":\"Privacy Policy\"},\"position\":{\"Defender\":\"Defender\",\"Midfielder\":\"Midfielder\",\"Forward\":\"Forward\",\"Goalkeeper\":\"Goalkeeper\"},\"faq\":{\"answer10\":\"To cancel your membership, go to this page and click “Cancel”. Your membership will remain active until the end of your current billing period and will then be canceled.\",\"question2\":\"APWin provides statistics from which leagues, and which specific markets?\",\"question3\":\"How can I use statistics to win in Sports Betting?\",\"answer2\":\"APWin covers more than 100 football leagues from around the world, with new competitions added regularly based on requests from our members. You can find stats on results, goals scored and conceded, corners, cards, offsides, head-to-head records and much more. If there’s a competition you’d like to see on APWin, let us know.\",\"answer6\":\"For this reason, we also offer the option of accessing APWin through a monthly membership. There are two main reasons for this. First, you don’t have to bet with a bookmaker you don’t want to use. Second, you can simply pay the monthly fee and get access to APWin without going through the full bookmaker verification process.\",\"answer4\":\"Using relevant statistics instead of simply checking match results can give you a much better basis for analysing a game. APWin presents past data in a simple way, helping you spot patterns and understand what the numbers could mean for upcoming matches. We can’t guarantee profits, but better analysis can help you make more informed betting decisions.\",\"question4\":\"By applying statistics to my bets, what is the % increase of my chance of winning?\",\"question5\":\"How can I have access to all the functionalities of the website?\",\"answer5\":\"All you need is to have a Premium account active and, with that, you will have access to all the functionalities of APWin.\\n    For that, you have 2 options:\\n    \u003col\u003e\\n    \u003cli\u003eCreate an account in one of the bookies we work with, and keep activity in that bookie\u003c/li\u003e\\n    \u003cli\u003ePay a monthly membership to keep access to all the functionalities of APWin\u003c/li\u003e\\n    \u003c/ol\u003e\\n    It’s easy, fast, and simple.\",\"question6\":\"I saw that I must create an account in the bookmaker to have Premium access. What if I already have an account in that bookmaker before I signed up for APWin?\",\"answer9\":\"Yes, but that has never been our focus. We want you to make your own bets, on what you want, when you want and how you want. You shouldn’t have to depend on someone else’s tips or results. Use our statistics and content to do your own analysis and make your own decisions. That’s the best way to improve as a bettor over time.\",\"answer8\":\"As a Premium member, you get unlimited access to all APWin statistics, educational content and our community of bettors. It’s a place for people who want to improve their analysis and get more from their betting.\",\"answer7\":\"To access APWin, simply visit the membership page and choose your preferred payment method. You can pay by debit or credit card, Skrill, Neteller, Visa or Mastercard.\",\"question10\":\"How do I cancel the subscription of my plan?\",\"question9\":\"Besides the statistics, does APWin provide betting tips?\",\"question7\":\"How do I subscribe to APWin Premium, what are the plans, and what are the payment methods?\",\"answer3\":\"Past statistics can give you a better idea of what to expect from a match. With APWin’s stats and betting content, you can learn more about sports betting, improve your match analysis and make better use of the opportunities you find.\",\"question1\":\"What is APWin?\",\"question8\":\"What are the advantages of Premium?\",\"answer1\":\"APWin is a football statistics platform with more than 10,000 statistical points updated every week. It’s built to help you analyse football matches, understand the numbers and make your own betting decisions. The aim is simple: give you the stats and information you need to bet smarter and improve your results over time.\"},\"date\":{\"Jun\":\"Jun\",\"December\":\"December\",\"Sun,\":\"Sun, \",\"Oct\":\"Oct\",\"Nov\":\"Nov\",\"Wed,\":\"Wed, \",\"Sat,\":\"Sat, \",\"September\":\"September\",\"October\":\"October\",\"November\":\"November\",\"Thu,\":\"Thu, \",\"Dec\":\"Dec\",\"Jul\":\"Jul\",\"Mon,\":\"Mon, \",\"Jan\":\"Jan\",\"Apr\":\"Apr\",\"Mar\":\"Mar\",\"Tue,\":\"Tue, \",\"Feb\":\"Feb\",\"Aug\":\"Aug\",\"Sep\":\"Sep\",\"Fri,\":\"Fri, \",\"January\":\"January\",\"February\":\"February\",\"March\":\"March\",\"April\":\"April\",\"May\":\"May\",\"June\":\"June\",\"July\":\"July\",\"August\":\"August\"},\"about\":{\"main_markets\":\"Key Betting Markets\",\"about_apwin\":\"About APWin\",\"img_about_3\":\"frontend/images/en/img_about_3.webp\",\"img_about_2\":\"frontend/images/en/img_about_2.webp\",\"personalized_filters\":\"Personalized Filters\",\"incomparable_compatibility\":\"Incomparable Compatibility\",\"why_we_do\":\"The Idea Behind APWin\",\"img_about_1\":\"frontend/images/en/img_about_1.webp\",\"besides_benefits\":\"You can also use APWin wherever you are. The platform works smoothly on desktop, tablet and mobile, so you can access your stats and match information from any device.\",\"our_platform\":\"Get a clearer picture of each match with useful football stats and team data. You can compare trends across markets like Over/Under, BTTS, 1X2, corners and handicaps, making it easier to see how teams have been performing before placing a bet.\",\"tips_stats\":\"Tips, stats and useful information to help you make better bets.\",\"surprised\":\"At APWin, we know that analysing a football match can take time and quickly become tiring. That’s why we’ve built our platform to make the process as simple as possible. You can find the key information, stats and insights you need in one place, making match analysis quicker and easier.\",\"our_goal\":\"Our goal is to save you time and give you the information you need to make smarter football bets. That’s why we created our platform in 2018, bringing together everything you need to analyse a match before placing your bet. Check team statistics, recent results, league standings, upcoming fixtures and a wide range of other data to help you assess each match and make more informed predictions.\",\"because_like_you\":\"Because, like you, we love sports and making predictions. After years of following the betting market and analysing matches, we decided to share what we’ve learned with you. Our aim is to give you useful statistics, insights and betting information\",\"everything_in_simple\":\"Everything is easy to find and quick to use. Whether you’re new to betting or an experienced bettor, APWin gives you the stats and tools you need to analyse football matches and make your predictions.\",\"apwin_allows\":\"APWin lets you create filters based on what you’re looking for. You can quickly find your favourite matches and focus on the betting markets you prefer.\",\"about_desc\":\"Learn more about APWin, a football statistics platform for bettors. Check match stats, team results, rankings and betting markets to find useful information before placing your bets.\"}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":[\"$L1a\",null,\"$L1b\",null,null,null,\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\"]}]\n23:I[581780,[\"https://cdnbfc.com/apwin/_next/static/chunks/1xn6msxzuk1bf.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/09ppr920jdqnx.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/31najnus7yci5.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/0djm-6p219cr6.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/3qn8kdbktnzsb.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/1nn4qrhbb-f8g.js\"],\"TrackingCoordinator\"]\n24:I[754691,[\"https://cdnbfc.com/apw