/_next/static/chunks/1nn4qrhbb-f8g.js\"],\"OddsFormatProvider\"]\n10:[\"$\",\"iframe\",null,{\"src\":\"https://www.googletagmanager.com/ns.html?id=GTM-N826TXC\",\"height\":\"0\",\"width\":\"0\",\"style\":{\"display\":\"none\",\"visibility\":\"hidden\"},\"title\":\"Google Tag Manager\"}]\n4:[\"$\",\"html\",null,{\"lang\":\"en\",\"data-ad-region\":\"~REST\",\"suppressHydrationWarning\":true,\"className\":\"inter_fe8b9d92-module__LINzvG__variable h-full scroll-pt-20 antialiased\",\"children\":[\"$\",\"body\",null,{\"className\":\"flex min-h-full flex-col bg-background pb-16 text-foreground md:pb-0\",\"children\":[[[\"$\",\"$Lf\",null,{\"id\":\"gtm\",\"strategy\":\"afterInteractive\",\"children\":\"(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\\nj=d.createElement(s),dl=l!='dataLayer'?'\u0026l='+l:'';j.async=true;j.src=\\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\\n})(window,document,'script','dataLayer','GTM-N826TXC');\"}],[\"$\",\"noscript\",null,{\"children\":\"$10\"}]],[\"$\",\"$Lf\",null,{\"id\":\"userback\",\"strategy\":\"afterInteractive\",\"children\":\"window.Userback = window.Userback || {};\\n  Userback.access_token = \\\"A-ha7hqstoSI1SbWns05jPj22Tk\\\";\\n  (function(d) {\\n    var s = d.createElement('script');s.async = true;s.src = 'https://static.userback.io/widget/v1.js';(d.head || d.body).appendChild(s);\\n  })(document);\"}],[\"$\",\"$L11\",null,{\"attribute\":\"class\",\"defaultTheme\":\"system\",\"enableSystem\":true,\"children\":[\"$\",\"$L12\",null,{\"children\":\"$L13\"}]}],[\"$\",\"$Lf\",null,{\"id\":\"optinmonster\",\"src\":\"https://a.omappapi.com/app/js/api.min.js\",\"strategy\":\"afterInteractive\",\"data-user\":\"319446\",\"data-account\":\"338590\"}]]}]}]\n14:I[175696,[\"https://cdnbfc.com/apwin/_next/static/chunks/1xn6msxzuk1bf.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/09ppr920jdqnx.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/31najnus7yci5.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/0djm-6p219cr6.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/3qn8kdbktnzsb.js\",\"https://cdnbfc.com/apwin/_next/static/chunks/1nn4qrhbb-f8g.js\"],\"default\"]\n15:T41d,\n    \u003cp\u003eHere are some important considerations for watching football matches in HD today:\u003c/p\u003e\n        \u003cul\u003e\n            \u003cli\u003e\u003cstrong\u003eWebsite Terms and Conditions:\u003c/strong\u003e Some bookmakers may offer live streams of sporting events, but this is generally subject to their terms and conditions. Make sure you carefully read the platform's T\u0026Cs to understand the restrictions and requirements for free streaming.\u003c/li\u003e\n            \u003cli\u003e\u003cstrong\u003eAccount creation:\u003c/strong\u003e In many cases, you may need to create an account with a betting site and possibly deposit funds into that account to access live streams.\u003c/li\u003e\n            \u003cli\u003e\u003cstrong\u003eLocal restrictions:\u003c/strong\u003e Many betting sites have geographic restrictions that limit who can access their live streams. Depending on where you live, you may not have access to certain sporting events.\u003c/li\u003e\n            \u003cli\u003e\u003cstrong\u003eStream Quality:\u003c/strong\u003e Sportsbook streams quality may vary. Therefore, test different platforms to find the best option for watching football matches live for free.\u003c/li\u003e\n        \u003c/ul\u003e\n    16:T49f,\n        \u003cp\u003eCurrently, the price of the \u003cstrong\u003eAPWin Premium Subscription service is $9.\u003c/strong\u003e\u003c/p\u003e\n        \u003cp\u003eThe platform reserves the right to unilaterally readjust, at any time, the values ​​of services or products without prior consultation or consent of the user.\u003c/p\u003e\n        \u003cp\u003eThe amounts applied are those in effect at the time of ordering.\u003c/p\u003e\n        \u003cp\u003ePrices are shown in reais and do not include delivery charges, which are specified separately and are informed to the user prior to placing the order.\u003c/p\u003e\n        \u003cp\u003eWhen contracting a certain service or product, the Hotmart platform may request the user's financial information, such as CPF, billing address and card data. By entering such data, the user agrees that, according to the payment method chosen, the prices then in force and informed when contracting are made.\u003c/p\u003e\n        \u003cp\u003eSaid financial data may be stored to facilitate access and future contracts.\u003c/p\u003e\n        \u003cp\u003eThe contracting of services will be automatically renewed by the platform, regardless of communication to the user, upon periodic charging of the same payment method indicated by the user when contracting the service.\u003c/p\u003e\n        17:Taa3,\n        \u003cp\u003eAccess to the platform's features will require prior registration and, depending on the services or products chosen, payment of a certain amount.\u003c/p\u003e\n        \u003cp\u003eWhen registering, the user must inform complete, recent and valid data, and it is their sole responsibility to keep such data up to date, and the user is committed to the veracity of the data provided.\u003c/p\u003e\n        \u003cp\u003eThe user undertakes not to inform their registration and/or platform access data to third parties, being fully responsible for their use.\u003c/p\u003e\n        \u003cp\u003eChildren under 18 years of age and those who do not have full civil capacity must obtain the express consent of their legal guardians to use the platform and services or products in advance, and any access by minors and those who do not are solely responsible for them. have full civil capacity without prior authorization.\u003c/p\u003e\n        \u003cp\u003eUpon completion of registration, the user expressly declares and warrants to be fully capable, being able to exercise and freely enjoy the services and products.\u003c/p\u003e\n        \u003cp\u003eThe user must provide a valid e-mail address through which the website will carry out all necessary communications.\u003c/p\u003e\n        \u003cp\u003eAfter confirming the registration, the user will have a login and a personal password, which ensures the user individual access to it. Thus, it is the user's sole responsibility to maintain that password in a confidential and secure manner, preventing undue access to personal information.\u003c/p\u003e\n        \u003cp\u003eAny and all activities carried out using the password will be the responsibility of the user, who must promptly inform the platform in case of misuse of the respective password.\u003c/p\u003e\n        \u003cp\u003eIt will not be allowed to assign, sell, rent or transfer, in any way, the account, which is personal and non-transferable.\u003c/p\u003e\n        \u003cp\u003eIt is up to the user to ensure that their equipment is compatible with the technical characteristics that enable the use of the platform and services or products.\u003c/p\u003e\n        \u003cp\u003eThe user may, at any time, \u003cstrong\u003erequest the cancellation of their registration with the Hotmart’s website, APWin's payment partner (explained in point 7.1).\u003c/strong\u003e Your unsubscribe will be carried out as soon as possible, as long as no outstanding debts are verified.\u003c/p\u003e\n        \u003cp\u003eThe user, by accepting the Terms and Privacy Policy, expressly authorizes the platform to collect, use, store, process, assign or use information derived from the use of the services, the website and any platforms, including all information filled in by the user on the time you perform or update your registration, in addition to others expressly described in the Privacy Policy that must be authorized by the user.\u003c/p\u003e\n        18:T439,\n        \u003cp\u003eThis Term of Use grants users a non-exclusive, non-transferable and non-sublicensable license to access and make use of the platform and the services and products made available by it.\u003c/p\u003e\n        \u003cp\u003eWebsite or application structure, brands, logos, trade names, layouts, graphics and interface design, images, illustrations, photographs, presentations, videos, written and sound and audio content, computer programs, database, files transmission and any other information and intellectual property rights of the company name are duly reserved.\u003c/p\u003e\n        \u003cp\u003eThese Terms of Use do not assign or transfer to the user any rights, so that access does not generate any intellectual property rights to the user, except for the limited license granted herein.\u003c/p\u003e\n        \u003cp\u003eThe use of the platform by the user is personal, individual and non-transferable, and any unauthorized, commercial or non-commercial use is prohibited. Such uses will constitute a violation of the intellectual property rights of the corporate name APWin, punishable under applicable law.\u003c/p\u003e\n        19:T585,\n        \u003cp\u003eIt is the responsibility of the user:\u003c/p\u003e\n        \u003cp\u003ea) technical defects or defects originating in the user's own system.\u003c/p\u003e\n        \u003cp\u003eb) the correct use of the platform, services or products offered, valuing good coexistence, respect and cordiality among users.\u003c/p\u003e\n        \u003cp\u003ec) for compliance with and respect for the set of rules set forth in this General Terms of Use Terms, in the respective Privacy Policy and in national and international legislation.\u003c/p\u003e\n        \u003cp\u003ed) for the protection of the access data to your account/profile (login and password).\u003c/p\u003e\n        \u003cp\u003ee) make sure that the bookmakers advertising on APWin’s platform comply with all the\n        regulations on your country\u003c/p\u003e\n        \u003cp\u003eIt is the responsibility of the APWin platform:\u003c/p\u003e\n        \u003cp\u003ea) indicate the characteristics of the service or product.\u003c/p\u003e\n        \u003cp\u003eb) defects and defects found in the service or product offered since it gave rise to them.\u003c/p\u003e\n        \u003cp\u003ec) the information that was disclosed by it, and the comments or information disclosed by users are the sole responsibility of the users themselves.\u003c/p\u003e\n        \u003cp\u003ed) illegal content or activities carried out through its platform.\u003c/p\u003e\n        \u003cp\u003eThe platform is not responsible for outgoing links in its system that may redirect the user to an\n        external environment of his network, including advertising from bookmakers.\u003c/p\u003e\n        13:[\"$\",\"$L14\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"home\":{\"short_super_odds\":\"Super Odds\",\"short_kalshi\":\"Kalshi\",\"short_viewer_title\":\"Story viewer\",\"short_pause\":\"Pause\",\"short_play\":\"Play\",\"super_odds_title\":\"Today's Super Odds \u0026 Boosts\",\"offer_super_odds\":\"Super Odds\",\"offer_odds_boost\":\"Odds Boost\",\"offer_prediction_market\":\"Prediction Market\",\"story_pick\":\"Pick\",\"story_prev_odds\":\"Prev Odds\",\"story_change\":\"Change\",\"prev_day\":\"Previous day\",\"sort_nearest_kickoff\":\"Kickoff\",\"next_day\":\"Next day\",\"match_count\":\"{count} games\",\"match_count_singular\":\"{count} game\",\"match_full_time\":\"Full Time\",\"market_1x2\":\"1X2\",\"market_btts_yes\":\"BTTS Yes\",\"accumulator_title\":\"Accumulator of the Day\",\"accumulator_odd_total\":\"Total odds\",\"accumulator_return_prefix\":\"return of\",\"bet_accumulator\":\"Bet Accumulator\",\"see_more\":\"See more matches\",\"welcome_bonus\":\"Welcome bonus\",\"prediction_market_title\":\"Prediction Market\",\"reg_time\":\"REG TIME (90mins + Stoppage)\",\"game_winner\":\"Game Winner\",\"trade_now\":\"Trade Now\",\"tie\":\"Tie\",\"today_matches_widget_title\":\"Today's Matches\",\"today_matches_see_all\":\"See all matches\",\"kalshi_story_begins\":\"Begins {when}\",\"kalshi_story_yes\":\"Yes {cents}¢\",\"kalshi_story_no\":\"No {cents}¢\",\"kalshi_story_disclaimer\":\"Trading on Kalshi involves risk and may not be appropriate for all. Any trading decisions you make are solely your responsibility and at your own risk.\",\"kalshi_story_cta_default\":\"Sign up to trade\",\"__deploy_probe\":\"ok\"},\"mobile_nav\":{\"label\":\"Mobile navigation\"},\"header\":{\"main_nav\":\"Main navigation\",\"settings\":\"Settings\",\"theme_label\":\"Theme\",\"light\":\"Light\",\"dark\":\"Dark\",\"system\":\"System\",\"odds_format_label\":\"Odds Format\",\"odds_decimal\":\"Decimal\",\"odds_fractional\":\"Fractional\",\"odds_moneyline\":\"Moneyline\",\"language_label\":\"Language\",\"language_br\":\"Português\",\"language_es\":\"Español\",\"language_en\":\"English\"},\"footer\":{\"columns_sections_title\":\"Sections\"},\"age_notice\":{\"title\":\"Are you over 18 years old?\",\"no\":\"No\",\"yes\":\"Yes\",\"underage_alert\":\"You must be over 18 years old to use this website.\"},\"cookie_consent\":{\"title\":\"We use cookies\",\"intro\":\"This website uses cookies in order to enhance the overall user experience.\",\"link_prefix\":\"Take a look at our\",\"link_label\":\"Cookies Policy\",\"link_suffix\":\"for more information.\",\"accept\":\"Okay\"},\"dropping_odds\":{\"what_are_dropping_odds\":\"What Are Dropping Odds?\",\"dropping_odds_body_1\":\"When a bookmaker shortens its odds on a selection, money has moved onto that side and the book has repriced it.\",\"dropping_odds_body_2\":\"Every row names the bookmaker that moved and shows the opening price next to the current one. Open a match to see each bookmaker's full price history.\",\"stat_dropping_odds\":\"Dropping Odds\",\"dropping_count\":\"{count, plural, =0 {No matches} one {# match} other {# matches}}\",\"bet_cta\":\"Bet\",\"strength_strong\":\"Strong\",\"strength_good\":\"Good\",\"strength_moderate\":\"Moderate\",\"movement_unavailable\":\"Odds history is not available for this selection right now.\",\"odds_movement_disclaimer\":\"Gamble responsibly, 18+\",\"seo_p_2\":\"Opening a match shows every listed bookmaker quoting the same selection, sorted by its own move, each with the full history of prices we recorded. Prices are snapshots taken over the days before kickoff, so a chart may hold only a handful of points.\",\"seo_p_1\":\"This page lists upcoming matches whose price has fallen at a bookmaker available in your country, ranked by how far it fell. Each row shows the opening price, the current price, and the bookmaker that repriced it.\",\"seo_title\":\"Dropping Odds Today: Which Prices Are Falling and Where\",\"hero_title\":\"{market} Dropping Odds\",\"hero_subtitle\":\"Find matches for which the odds have dropped over the last few days. Dropping odds may indicate an opportunity for a value bet.\"},\"decreasing_stats\":{\"probability_column\":\"{stat} Probability (%)\",\"match_count\":\"{count, plural, =0 {No matches} one {# match} other {# matches}}\",\"match_count_singular\":\"{count} match\",\"section_scored\":\"Scored\",\"section_conceded\":\"Conceded\",\"section_for\":\"For\",\"section_against\":\"Against\",\"seo_title\":\"More About Decreasing Stats\",\"seo_body\":\"Are you looking for the best stats to make your sports betting predictions today? Check our decreasing stats. We have filtered the best opportunities so that you can go straight to the point in analyzing football matches to make your bets for today. Make sure you start your analysis here, and your sports bets will not only be more accurate, but also you will be much more efficient\",\"hero_title\":\"Best Football Matches to Bet on in {stat} Today\",\"hero_subtitle\":\"List of statistics in decreasing order showing the football matches you should bet on in the {stat} today.\"},\"meta\":{\"decreasing_stats\":{\"description\":\"Upcoming football matches ranked by the probability of {stat}, highest first. Filter 